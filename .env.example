# Local development only. Never commit a real value here.
NODE_ENV=development
PORT=3000
DB_PROVIDER=sqlite
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000

# Production Firebase Functions
# DB_PROVIDER is set to firestore by index.js.
# JWT is injected by Secret Manager as xenproperty_jwt.
# PROPERTY_IMAGES_BUCKET=your-project.appspot.com
