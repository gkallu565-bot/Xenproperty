rules_version = '2';

// All reads and writes go through the XenProperty Cloud Function, which uses
// the Admin SDK (bypasses these rules) and enforces JWT auth + admin checks.
// Direct client access is therefore denied entirely: the frontend never talks to
// Firestore, it only calls /api/*.
service cloud.firestore {
  match /databases/{database}/documents {
    function isManager() {
      return request.auth != null
        && request.auth.token.email == 'gkallu565@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Public catalogue is readable, but only the authenticated manager can
    // publish or remove a live property.
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Sellers may submit a review request. Only the manager can inspect,
    // approve, reject, or delete pending records.
    match /pending_properties/{propertyId} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read: if isManager()
        || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow update, delete: if isManager()
        || (isSignedIn() && resource.data.user_id == request.auth.uid && resource.data.status == 'pending');
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read, update: if isManager() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isManager();
    }
    match /inquiries/{id} {
      allow read, write: if isManager();
    }
    match /loan_applications/{id} {
      allow read, write: if isManager();
    }
    match /design_requests/{id} {
      allow read, write: if isManager();
    }
  }
}
