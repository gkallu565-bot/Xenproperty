rules_version = '2';

// All reads and writes go through the XenProperty Cloud Function, which uses
// the Admin SDK (bypasses these rules) and enforces JWT auth + admin checks.
// Direct client access is therefore denied entirely: the frontend never talks to
// Firestore, it only calls /api/*.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}