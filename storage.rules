rules_version = '2';

// Listing photos are public so the CDN can serve them; uploads only ever happen
// server-side through the Cloud Function (Admin SDK bypasses these rules).
service firebase.storage {
  match /b/{bucket}/o {
    match /properties/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
